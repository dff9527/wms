# 後端環境變數範本 — 複製為 .env 後填入實際值
# (.env 已被 .gitignore 忽略，請勿提交真實金鑰)

DATABASE_URL=postgresql://wms_user:wms_password@localhost:5433/wms_semiconductor
REDIS_URL=redis://localhost:6379

# Round 2 條碼 AI 學習引擎需要
